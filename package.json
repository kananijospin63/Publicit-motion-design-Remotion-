{
  "name": "jovim-code-ad",
  "version": "1.0.0",
  "private": true,
  "description": "Publicité motion design JOVIM CODE (Remotion, 1080x1920, 30fps, 32s)",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "still": "remotion still src/index.ts JovimAd out/preview.png --frame=60",
    "render": "remotion render src/index.ts JovimAd out/jovim-code-ad.mp4 --codec=h264 --crf=16",
    "voice": "node scripts/generate-voiceover.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "@remotion/google-fonts": "4.0.290",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
